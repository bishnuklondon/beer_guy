# Optional: enables LLM-based menu parsing (falls back to a heuristic
# regex parser when this is not set).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Networking
SCRAPER_REQUEST_TIMEOUT=20
SCRAPER_MAX_CANDIDATES=5
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; MenuScraperBot/1.0)

# Storage: defaults to <project_root>/data/delta_tables
SCRAPER_DELTA_DIR=
